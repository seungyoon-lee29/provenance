# Runtime policy and canonical public origin
APP_ENVIRONMENT=development
APP_PUBLIC_ORIGIN=http://localhost:3000
PROVIDER_BILLING_MODE=free_only
LOCAL_PROVIDER_CREDENTIAL_MODE=contract_only
# Set only for a single-owner development deployment; never share this workspace.
LOCAL_PROVIDER_OWNER_WORKSPACE_ID=

# User credential vault; local KEK is development/test only
CREDENTIAL_VAULT_PROVIDER=disabled
CREDENTIAL_LOCAL_KEYRING_FILE=.secrets/credential-keyring.json
CREDENTIAL_VAULT_KMS_KEY_REF=
ENABLE_SYNTHETIC_PROVIDER=false
# Keyless public-domain US Treasury yield feed (guest track); off = zero external egress
PUBLIC_MARKET_TREASURY_ENABLED=false
ENABLE_LIVE_TRADING=false
ENABLED_PAID_ADAPTERS=
ENABLED_PAID_ROUTES=
ENABLED_PAID_SCHEDULES=
DATABASE_URL=postgresql://fakebloomberg:fakebloomberg@127.0.0.1:5432/fakebloomberg
REDIS_URL=redis://127.0.0.1:6379
WORKER_HEALTH_PORT=3001

# Federated identity; callback paths are fixed server routes
GOOGLE_IDENTITY_ENABLED=false
GOOGLE_IDENTITY_CLIENT_ID=
GOOGLE_IDENTITY_CLIENT_SECRET=
GOOGLE_IDENTITY_CALLBACK_PATH=/auth/callback/google
GITHUB_IDENTITY_ENABLED=false
GITHUB_IDENTITY_CLIENT_ID=
GITHUB_IDENTITY_CLIENT_SECRET=
GITHUB_IDENTITY_CALLBACK_PATH=/auth/callback/github

# Gemini (server-only)
GEMINI_API_KEY=

# Alpaca Basic / Paper (server-only secrets + non-secret policy)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_ENVIRONMENT=paper
ALPACA_DATA_FEED=iex
RUN_ALPACA_BASIC_DATA_CONTRACT=false
RUN_ALPACA_PAPER_READ_CONTRACT=false
RUN_ALPACA_PAPER_ORDER_CONTRACT=false

# Korea Investment & Securities (server-only secrets + allowlisted environment)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENVIRONMENT=paper
KIS_REST_BASE=
RUN_KIS_PERSONAL_DATA_CONTRACT=false
RUN_KIS_PAPER_READ_CONTRACT=false
RUN_KIS_PAPER_ORDER_CONTRACT=false

# Public filings / KRX EOD (server-only)
DART_API_KEY=
KRX_API_KEY=

# Optional email; delivery secrets come from the selected keyring
EMAIL_DELIVERY_PROVIDER=disabled
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO_ADDRESS=

# Local/CI email capture only
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_API_BASE_URL=http://mailpit:8025
MAILPIT_UI_URL=http://127.0.0.1:8025

# Optional delivery keyring; disabled keeps in-app alerts working
DELIVERY_KEYRING_PROVIDER=disabled
DELIVERY_LOCAL_KEYRING_FILE=.secrets/delivery-keyring.json
DELIVERY_KEYRING_REF=
