{
  "name": "fakebloomberg",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch src/worker/main.ts",
    "worker:start": "tsx src/worker/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:public-seam": "tsx tests/public-seam.example.ts",
    "test:server-seam": "tsx tests/server-seam.example.ts",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "db:status": "tsx scripts/migrate.ts status",
    "verify:network-off": "tsx scripts/verify-network-off.ts",
    "verify:migrations": "tsx scripts/verify-migrations.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:public-seam && npm run test:server-seam",
    "check:pr": "npm run compose:verify",
    "compose:verify": "sh scripts/verify-compose.sh",
    "compose:up": "docker compose --profile local up --build --wait",
    "compose:down": "docker compose down --remove-orphans"
  },
  "dependencies": {
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "redis": "6.1.0",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
