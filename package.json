{
  "name": "provenance",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "cli": "tsx src/cli/main.ts",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch src/worker/main.ts",
    "worker:start": "tsx src/worker/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:performance": "playwright test --config=playwright.performance.config.ts",
    "db:migrate": "tsx scripts/migrate.ts up",
    "db:rollback": "tsx scripts/migrate.ts down",
    "db:status": "tsx scripts/migrate.ts status",
    "verify:network-off": "tsx scripts/verify-network-off.ts",
    "verify:migrations": "tsx scripts/verify-migrations.ts",
    "test:persistence-pg": "vitest run tests/persistence/personal-cache.pg.test.ts tests/persistence/identity-store.pg.test.ts tests/persistence/erase-atomicity.pg.test.ts tests/persistence/identity-composition.pg.test.ts tests/persistence/paper-journal.pg.test.ts tests/persistence/paper-cli.pg.test.ts tests/property/money-conservation.property.test.ts",
    "verify:backup-drill": "tsx scripts/backup-drill.ts",
    "package:release": "tsx scripts/package-release.ts",
    "check:release-docs": "tsx scripts/check-release-docs.ts",
    "test:mutation": "stryker run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:f1": "npm run check && npm run test:browser && npm run test:performance",
    "check:f2": "npm run check && npm run test:browser && npm run test:performance",
    "check:pr": "npm run compose:verify",
    "compose:verify": "sh scripts/verify-compose.sh",
    "compose:up": "docker compose --profile local up --build --wait",
    "compose:down": "docker compose down --remove-orphans",
    "prepare": "husky",
    "mcp": "tsx src/mcp/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "next": "16.2.10",
    "pg": "8.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "redis": "6.1.0",
    "server-only": "file:vendor/server-only",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
